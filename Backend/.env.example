# Copy this file to .env and fill in the values. .env is gitignored, this file is not.

# JWT signing key, generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Email (a Mailtrap sandbox works: it catches every email, nothing reaches a real inbox)
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true
FRONTEND_URL=http://localhost:5173

# AWS S3 (profile pictures), the IAM user only needs put/delete under profile_pics/
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
